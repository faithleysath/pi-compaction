{
  "name": "pi-compaction",
  "version": "0.1.0",
  "description": "Algorithmic context compaction for pi — filter and truncate instead of an LLM summary, with #N recall of the originals",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faithleysath/pi-compaction.git"
  },
  "homepage": "https://github.com/faithleysath/pi-compaction",
  "bugs": {
    "url": "https://github.com/faithleysath/pi-compaction/issues"
  },
  "pi": {
    "extensions": [
      "./extensions/pi-compaction.ts",
      "./extensions/pi-recall.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.74.0 <2.0.0",
    "typebox": ">=1.1.24 <2.0.0"
  },
  "scripts": {
    "test": "bun run tests/compaction.test.ts && bun run tests/recall.test.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "bun run tests/e2e/run.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
